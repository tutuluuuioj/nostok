# Read-only HTTP & Prometheus server bind settings
PORT=3002
HOST=127.0.0.1

# Read-only Base RPC endpoint
RPC_URL=http://127.0.0.1:8545

# Chain verification (Base Mainnet = 8453; set FORK=true only for fork/test runs)
FORK=false
FORK_CHAIN_ID=8453

# Read-only PostgreSQL connection string (ONLY DB secret the risk monitor reads; required when FORK=false).
# PRODUCTION REQUIREMENT: Use a dedicated SELECT-only role (nostok_ro) with no write/DDL privileges.
# Example: postgresql://nostok_ro:CHANGE_ME@127.0.0.1:5432/nostok
DATABASE_URL=

# Scanning cadence and alert thresholds
POLL_INTERVAL_MS=10000
ALERT_COOLDOWN_MS=300000
ALERT_MIN_ACTIVE_MS=2000
WEBHOOK_TIMEOUT_MS=5000
NEAR_LIQ_BUFFER_BPS=300
PRICE_DEVIATION_WARN_BPS=500
KEEPER_INACTIVITY_ALERT_SECS=120
MAX_HEALTHY_LAG_BLOCKS=20
MAX_HEALTHY_LAG_SECS=120

# Optional alert webhook URL (leave unset when not using webhook delivery)
# WEBHOOK_URL=

# HTTP hardening controls
CORS_ORIGINS=*
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_BUCKETS=10000
TRUST_PROXY=0
MAX_BODY_BYTES=65536
MAX_PAGE_LIMIT=100

# Protocol contract addresses (read-only view calls only; zero private keys)
LOAN_CORE_ADDRESS=
LIQUIDATION_AUCTION_ADDRESS=
COLLATERAL_ESCROW_ADDRESS=
ASSET_REGISTRY_ADDRESS=
ORACLE_ROUTER_ADDRESS=
