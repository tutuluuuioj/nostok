# Target Chain (Base Mainnet = 8453; production builds throw if VITE_CHAIN_ID != 8453)
VITE_CHAIN_ID=8453
# Set VITE_IS_FORK=true ONLY for local Base Mainnet fork testing (never in production builds)
VITE_IS_FORK=false
# Production builds MUST use a dedicated/private https:// Base RPC endpoint (public mainnet.base.org is rate-limited)
VITE_RPC_URL=https://mainnet.base.org

# Offchain backend endpoints (production builds require https:// URLs)
VITE_API_URL=http://127.0.0.1:3001
VITE_NOTIFICATIONS_URL=http://127.0.0.1:3003
VITE_RISK_URL=http://127.0.0.1:3002

# SIWE host/origin binding: notifications/ SIWE_DOMAIN must equal the hosted frontend hostname (window.location.host)
VITE_SIWE_DOMAIN=
VITE_SIWE_ORIGIN=

# Base USDC token address (6 decimals) — pinned to official Base USDC in non-fork production builds
VITE_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Core protocol contract addresses on Base (all 8 required in production builds; never put private keys here)
VITE_LOAN_CORE_ADDRESS=
VITE_ORDER_SETTLEMENT_ADDRESS=
VITE_LIQUIDATION_AUCTION_ADDRESS=
VITE_POSITION_NFT_ADDRESS=
VITE_COLLATERAL_ESCROW_ADDRESS=
VITE_ASSET_REGISTRY_ADDRESS=
VITE_ORACLE_ROUTER_ADDRESS=
VITE_ELIGIBILITY_GATE_ADDRESS=
