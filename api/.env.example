# Read-only HTTP API bind settings
PORT=3001
HOST=127.0.0.1

# Read-only Base RPC endpoint (archive-capable recommended)
RPC_URL=http://127.0.0.1:8545

# Chain verification (Base Mainnet = 8453; set FORK=true only for fork/test runs)
FORK=false
FORK_CHAIN_ID=8453

# Read-only PostgreSQL connection string (ONLY secret the API reads; required when FORK=false).
# PRODUCTION REQUIREMENT: Configure DATABASE_URL using a dedicated SELECT-only role (e.g. nostok_ro)
# granted SELECT on indexer tables and NO INSERT/UPDATE/DELETE/DDL or superuser privileges.
# default_transaction_read_only=on and SQL allowlist validation are defense-in-depth only.
# Example: postgresql://nostok_ro:CHANGE_ME@127.0.0.1:5432/nostok
DATABASE_URL=

# Security, CORS, pagination & rate-limiting controls
CORS_ORIGINS=*
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_BUCKETS=10000
MAX_BODY_BYTES=65536
MAX_PAGE_LIMIT=100

# Edge Geoblock & Trusted Proxy Controls
# PRODUCTION REQUIREMENT (FORK=false): API refuses to start unless TRUST_PROXY>=1 AND GEO_REQUIRE_HEADER=true
# (or set GEO_DISABLED=true to explicitly disable geoblocking with a warning).
# CRITICAL (L1): When TRUST_PROXY>=1, the API trusts X-Forwarded-For and GEO_COUNTRY_HEADER (cf-ipcountry).
# You MUST either lock down OS/VPC firewall rules so ONLY Cloudflare / your trusted proxy can reach the API port,
# AND/OR configure TRUSTED_PROXY_CIDRS with exact proxy/Cloudflare CIDR ranges so spoofed direct headers fail closed.
TRUST_PROXY=0
TRUSTED_PROXY_CIDRS=
GEO_COUNTRY_HEADER=cf-ipcountry
GEO_REQUIRE_HEADER=false
GEO_RESTRICTED_COUNTRIES=US,CU,IR,KP,SY,RU,BY,MM
GEO_DISABLED=false

# Comma-separated checksummed/hex EVM addresses blocked from Eligibility screening & order intake (logs loud warning if empty)
SANCTIONED_ADDRESSES=

# Optional indexer lag warning threshold in blocks (used by /health)
MAX_HEALTHY_LAG_BLOCKS=20

# Protocol contract addresses (read-only view calls only; zero private keys)
LOAN_CORE_ADDRESS=
ORDER_SETTLEMENT_ADDRESS=
LIQUIDATION_AUCTION_ADDRESS=
POSITION_NFT_ADDRESS=
COLLATERAL_ESCROW_ADDRESS=
ASSET_REGISTRY_ADDRESS=
ORACLE_ROUTER_ADDRESS=
FEE_COLLECTOR_ADDRESS=
ELIGIBILITY_GATE_ADDRESS=
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
