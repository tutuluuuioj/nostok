# Read-only Base RPC endpoint
RPC_URL=http://127.0.0.1:8545

# Chain verification (Base Mainnet = 8453; set FORK=true if using a fork)
FORK=false
FORK_CHAIN_ID=8453

# PostgreSQL connection string (e.g. postgresql://user:pass@localhost:5432/nostok).
# Leave empty or unset to run embedded PostgreSQL via PGlite (memory:// or ./data/pg).
DATABASE_URL=

# Block scanning range and reorg confirmation window
START_BLOCK=0
CONFIRMATIONS=12
POLL_INTERVAL_MS=4000
BLOCK_BATCH_SIZE=200

# Optional JSON config file path
# CONFIG_PATH=./config.json

# Core NOSTOK contract addresses (read-only; no private key needed)
LOAN_CORE_ADDRESS=
ORDER_SETTLEMENT_ADDRESS=
LIQUIDATION_AUCTION_ADDRESS=
POSITION_NFT_ADDRESS=
COLLATERAL_ESCROW_ADDRESS=
ASSET_REGISTRY_ADDRESS=
ORACLE_ROUTER_ADDRESS=

# Comma-separated listed B20 collateral token addresses (tracks Transfer to/from CollateralEscrow)
ASSET_LIST=
