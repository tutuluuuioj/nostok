# HTTP server bind settings
PORT=3003
HOST=127.0.0.1

# Read-only Base RPC endpoint (used for chainId validation, SIWE EIP-1271 verifyMessage, and read-only view fallbacks)
RPC_URL=http://127.0.0.1:8545

# Chain verification (Base Mainnet = 8453; set FORK=true only for local fork tests)
FORK=false
FORK_CHAIN_ID=8453

# Read/Write PostgreSQL connection string for notif_* tables ONLY (required when FORK=false).
# Grant INSERT/UPDATE/DELETE/SELECT strictly on notif_* tables to nostok_notif role; NO write grant on indexer tables.
DATABASE_URL=

# Read-only PostgreSQL connection string for indexer tables (loans, loan_events, auctions, positions, assets).
# PRODUCTION REQUIREMENT: Must use SELECT-only nostok_ro role.
INDEXER_DATABASE_URL=

# Optional Risk Monitor HTTP endpoint (e.g. http://127.0.0.1:3002); falls back to on-chain views if unreachable
RISK_API_URL=http://127.0.0.1:3002

# SIWE (EIP-4361) wallet verification domain and URI
SIWE_DOMAIN=app.nostok.xyz
SIWE_URI=https://app.nostok.xyz
SIWE_NONCE_TTL_SECS=600
SESSION_TTL_SECS=86400

# Secrets from environment only (NEVER commit real keys)
# AES-256-GCM key ring formatted as "<keyId>:<64-hex-chars>" comma-separated, e.g. "k1:<64hex>,k2:<64hex>"
ENCRYPTION_KEY_ID=k1
ENCRYPTION_KEYS=
# Or single active 64-hex-char AES-256 key when only one key id is active:
ENCRYPTION_KEY=
# Independent high-entropy HMAC-SHA256 keys (minimum 24 chars, all distinct)
UNSUBSCRIBE_SECRET=
CONFIRM_SECRET=
SESSION_SECRET=
PII_HASH_SECRET=
WEBHOOK_SIGNING_SECRET=
# Optional admin secret for POST /dead-letters/redrive across all wallets
ADMIN_SECRET=

# Public URL used in generated confirmation/unsubscribe links (https:// required when FORK=false)
PUBLIC_BASE_URL=https://notifications.nostok.xyz

# Channel delivery settings (outbound HTTP timeouts apply to every request)
SMTP_API_URL=
SMTP_API_KEY=
EMAIL_FROM=alerts@nostok.xyz
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org

# Engine cadence, retries, rate limits, circuit breaker
POLL_INTERVAL_MS=10000
OUTBOUND_TIMEOUT_MS=5000
MAX_DELIVERY_ATTEMPTS=3
MAX_CRITICAL_DELIVERY_ATTEMPTS=6
RETRY_BASE_MS=60000
SENDING_LEASE_MS=120000
EPISODE_CLEAR_DAMPING_MS=120000
ALLOWED_WEBHOOK_PORTS=443
USER_RATE_LIMIT_PER_HOUR=30
MAX_SUBSCRIPTIONS_PER_WALLET=5
MAX_VERIFY_ATTEMPTS=5
CONFIRM_RATE_LIMIT_MAX=10
CONFIRM_TARGET_PER_HOUR_MAX=3
CONFIRM_TARGET_GLOBAL_PER_HOUR_MAX=10
DELIVERY_CONCURRENCY=5
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_COOLDOWN_MS=30000

# HTTP API hardening (CORS_ORIGINS required in production; wildcard * disallowed)
CORS_ORIGINS=https://app.nostok.xyz
RATE_LIMIT_MAX=120
AUTH_NONCE_RATE_LIMIT_MAX=20
AUTH_VERIFY_RATE_LIMIT_MAX=20
SUBSCRIPTIONS_RATE_LIMIT_MAX=15
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_BUCKETS=10000
TRUST_PROXY=0
MAX_BODY_BYTES=65536
MAX_PAGE_LIMIT=100

# Protocol contract addresses (read-only view calls only; zero private keys)
LOAN_CORE_ADDRESS=
LIQUIDATION_AUCTION_ADDRESS=
ASSET_REGISTRY_ADDRESS=
ORACLE_ROUTER_ADDRESS=
POSITION_NFT_ADDRESS=
